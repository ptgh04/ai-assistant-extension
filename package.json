    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@wxt-dev/module-react": "^1.1.3",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.7.3",
    "wxt": "^0.19.28"
  },
  "overrides": {
    "@vitejs/plugin-react": "4.3.4"
  }
